<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:fitsSystemWindows="true"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp"
    android:paddingTop="32dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardQuizHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="15dp">

            <ImageView
                android:id="@+id/btnThoat"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#FFFFFF"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/txtSubjectTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="MÔN HỌC"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="serif"
                android:textStyle="bold" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/cardQuizHeader"
        android:layout_marginTop="20dp"
        android:backgroundTint="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtQuestionNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="28sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/txtQuestionContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#202C39"
                android:textSize="18sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/layoutAnswers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/cardQuestion"
        android:layout_marginTop="25dp">

        <Button
            android:id="@+id/btnAnswerA"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#202C39"
            android:textSize="16sp"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#DCDCDC"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btnAnswerB"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#202C39"
            android:textSize="16sp"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#DCDCDC"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btnAnswerC"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#202C39"
            android:textSize="16sp"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#DCDCDC"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btnAnswerD"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#202C39"
            android:textSize="16sp"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#DCDCDC"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnMenuGrid"
        android:layout_width="45dp"
        android:layout_height="80dp"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="-25dp"
        android:layout_above="@id/layoutBottom"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="4dp"
            android:src="@android:drawable/ic_media_previous"
            app:tint="#FFFFFF" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/layoutBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="20dp"
        android:weightSum="2">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:backgroundTint="#757575"
            android:text="BACK"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:cornerRadius="10dp" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="NEXT"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:cornerRadius="10dp" />
    </LinearLayout>

</RelativeLayout>